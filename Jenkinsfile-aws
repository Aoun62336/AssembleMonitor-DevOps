pipeline {
    agent any

    environment {
        AWS_REGION = 'us-east-1'
        ASG_NAME = 'assemblemonitor-advance-dev-asg'

        DOCKERHUB_USERNAME = 'fire2686'
        BACKEND_IMAGE = 'fire2686/assemblemonitor-backend'
        FRONTEND_IMAGE = 'fire2686/assemblemonitor-frontend'
        IMAGE_TAG = "${BUILD_NUMBER}"

        EC2_USER = 'ubuntu'
        EC2_PROJECT_DIR = '/home/ubuntu/AssembleMonitor-DevOps'
        COMPOSE_FILE = 'docker-compose.alb.yml'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Show Build Info') {
            steps {
                sh '''
                    echo "Build Number: ${BUILD_NUMBER}"
                    echo "Backend Image: ${BACKEND_IMAGE}:${IMAGE_TAG}"
                    echo "Frontend Image: ${FRONTEND_IMAGE}:${IMAGE_TAG}"
                    echo "Workspace:"
                    pwd
                    ls -la
                '''
            }
        }

        stage('Docker Check') {
            steps {
                sh '''
                    docker --version
                    docker compose version || true
                '''
            }
        }

        stage('Backend Build Validation') {
            steps {
                sh '''
                    docker build \
                      -t assemblemonitor-backend-check:${IMAGE_TAG} \
                      ./backend

                    docker run --rm \
                      assemblemonitor-backend-check:${IMAGE_TAG} \
                      python -m compileall app
                '''
            }
        }

        stage('Frontend Build Validation') {
            steps {
                sh '''
                    docker build \
                      -t assemblemonitor-frontend-check:${IMAGE_TAG} \
                      ./frontend
                '''
            }
        }

        stage('Build Final Images') {
            steps {
                sh '''
                    docker build \
                      -t ${BACKEND_IMAGE}:${IMAGE_TAG} \
                      -t ${BACKEND_IMAGE}:latest \
                      ./backend

                    docker build \
                      -t ${FRONTEND_IMAGE}:${IMAGE_TAG} \
                      -t ${FRONTEND_IMAGE}:latest \
                      ./frontend
                '''
            }
        }

        stage('Login to Docker Hub') {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'dockerhub-creds',
                    usernameVariable: 'DOCKER_USER',
                    passwordVariable: 'DOCKER_TOKEN'
                )]) {
                    sh '''
                        echo "$DOCKER_TOKEN" | docker login -u "$DOCKER_USER" --password-stdin
                    '''
                }
            }
        }

        stage('Push Images') {
            steps {
                sh '''
                    docker push ${BACKEND_IMAGE}:${IMAGE_TAG}
                    docker push ${BACKEND_IMAGE}:latest

                    docker push ${FRONTEND_IMAGE}:${IMAGE_TAG}
                    docker push ${FRONTEND_IMAGE}:latest
                '''
            }
        }

        stage('Trigger ASG Instance Refresh') {
            steps {
                sh '''
                    echo "Starting ASG Instance Refresh for ${ASG_NAME}..."
                    aws autoscaling start-instance-refresh \
                      --region ${AWS_REGION} \
                      --auto-scaling-group-name ${ASG_NAME}
                    echo "Instance Refresh initiated! AWS will now handle the rolling update."
                '''
            }
        }
    }

    post {
        success {
            echo 'Jenkins AWS CI/CD pipeline completed successfully.'
        }

        failure {
            echo 'Pipeline failed. Check the failed stage logs.'
        }

        always {
            sh '''
                docker logout || true
                docker image prune -f || true
            '''
        }
    }
}