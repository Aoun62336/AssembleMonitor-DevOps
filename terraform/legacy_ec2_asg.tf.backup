# =======================================================================
# LEGACY EC2 ASG RESOURCES - BACKED UP FOR FUTURE REFERENCE
# =======================================================================
# This file ends in .tf.backup so Terraform completely ignores it,
# but your old Docker Compose setup is perfectly preserved here.
# If you ever want to use it again, rename this file to legacy_ec2_asg.tf

/*
resource "aws_launch_template" "app_lt" {
  name_prefix   = "${local.name_prefix}-lt-"
  image_id      = data.aws_ami.ubuntu.id
  instance_type = var.app_instance_type
  key_name      = var.key_pair_name

  iam_instance_profile {
    name = aws_iam_instance_profile.app_instance_profile.name
  }

  network_interfaces {
    associate_public_ip_address = false
    security_groups             = [aws_security_group.app_sg.id]
