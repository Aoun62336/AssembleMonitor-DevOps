# Force Unix LF line endings for all text-based files
* text=auto eol=lf

# Explicitly mark binary files so they are never modified
*.png binary
*.jpeg binary
*.jpg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.tar.gz binary

# Exclude legacy role-based HTML templates from GitHub language statistics
# These are Vanilla HTML/JS dashboards served as static files;
# the primary application stack is React (JSX) + FastAPI + Terraform.
frontend/public/admin/**   linguist-vendored linguist-detectable=false
frontend/public/pm/**      linguist-vendored linguist-detectable=false
frontend/public/se/**      linguist-vendored linguist-detectable=false
frontend/public/client/**  linguist-vendored linguist-detectable=false
